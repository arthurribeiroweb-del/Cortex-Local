PORT=3000
# HOST=127.0.0.1 limita ao proprio PC (mais seguro).
# HOST=0.0.0.0 expoe na rede local (necessario para acesso pelo celular).
HOST=127.0.0.1

# Token de acesso opcional. Se definido, todas as rotas /api (exceto /api/health)
# passam a exigir esse token. Recomendado quando HOST=0.0.0.0 (acesso pela rede).
# No navegador, o Cortex-Local pede o token uma vez e guarda localmente.
# Deixe vazio para acesso local aberto (sem login).
AUTH_TOKEN=

# HTTPS opcional (necessario para microfone em celular/tablet fora do localhost).
# Gere o certificado em certs/ e o servidor liga o HTTPS automaticamente.
HTTPS_PORT=3443
CERT_KEY=certs/key.pem
CERT_FILE=certs/cert.pem
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=60000
DEFAULT_MODEL=qwen2.5:3b
DRAFT_MODEL=qwen2.5:3b
CRITIC_MODEL=mistral:7b
FINAL_MODEL=qwen2.5:3b

# Modelos do conselho multiagente local.
AGENT_MODEL_MAIN=qwen3.6:27b
AGENT_MODEL_CODER=qwen3-coder:30b
AGENT_MODEL_VISION=qwen3-vl:32b
AGENT_MODEL_REASONING=deepseek-r1:32b
AGENT_MODEL_AUTOMATION=devstral-small-2:latest
AGENT_MODEL_CRITIC=mistral-small3.2:24b
AGENT_MODEL_VALIDATOR=gemma4:31b
AGENT_MODEL_QUICK=mistral:7b
AGENT_MODEL_QUICK_CODER=qwen2.5-coder:7b
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=http://localhost:8080
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=12000

# Voz local (Whisper STT + Piper TTS). Troque WHISPER_MODEL para melhorar a
# transcricao: ggml-small.bin ja melhora muito na CPU; ggml-medium/large-v3
# ficam excelentes com a 4090 (whisper.cpp com CUDA).
WHISPER_EXE=C:/PROJETOS/IA-LOCAL/tools/whisper.cpp/Release/whisper-cli.exe
WHISPER_MODEL=C:/PROJETOS/IA-LOCAL/models/whisper/ggml-base.bin
WHISPER_LANGUAGE=pt
PIPER_EXE=C:/PROJETOS/IA-LOCAL/tools/piper/piper/piper.exe
PIPER_MODEL=C:/PROJETOS/IA-LOCAL/models/piper/pt_BR-faber-medium.onnx
